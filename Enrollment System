<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enrollment Student Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #ffffff;
      color: #333333;
      font-size: 14px;
    }

    /* ===== LAYOUT ===== */
    .layout {
      display: flex;
      min-height: 100vh;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
      width: 230px;
      padding: 20px 0;
      border-right: 1px solid #dddddd;
      flex-shrink: 0;
    }

    .sidebar-brand {
      padding: 0 20px 20px 20px;
      border-bottom: 1px solid #dddddd;
      margin-bottom: 15px;
    }

    .sidebar-brand h1 {
      font-size: 20px;
      font-weight: bold;
      color: #1a2b4a;
      letter-spacing: 0.5px;
    }

    .sidebar-brand p {
      font-size: 11px;
      color: #777777;
      letter-spacing: 1.5px;
      margin-top: 2px;
    }

    .menu-label {
      font-size: 10px;
      color: #999999;
      letter-spacing: 1px;
      padding: 15px 20px 6px 20px;
      font-weight: bold;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 20px;
      font-size: 13px;
      color: #444444;
      border-left: 3px solid transparent;
    }

    .menu-item.active {
      border-left-color: #1a2b4a;
      font-weight: bold;
      color: #1a2b4a;
    }

    .menu-item .icon {
      width: 16px;
      display: inline-block;
      text-align: center;
      font-size: 12px;
      color: #666666;
    }

    /* ===== MAIN AREA ===== */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* topbar */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 25px;
      border-bottom: 1px solid #dddddd;
    }

    .topbar h2 {
      font-size: 16px;
      font-weight: bold;
      color: #1a2b4a;
      letter-spacing: 1px;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: #444444;
    }

    .user-avatar {
      width: 28px;
      height: 28px;
      background: #e8e8e8;
      border: 1px solid #cccccc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      color: #555555;
    }

    /* content */
    .content {
      padding: 20px 25px 40px 25px;
      flex: 1;
    }

    /* generic panel */
    .panel {
      border: 1px solid #dddddd;
      margin-bottom: 20px;
      background: #ffffff;
    }

    .panel-title {
      padding: 12px 18px;
      border-bottom: 1px solid #dddddd;
      font-size: 14px;
      font-weight: bold;
      color: #1a2b4a;
      background: #fafafa;
    }

    .panel-body {
      padding: 16px 18px;
      font-size: 13px;
      color: #555555;
    }

    /* welcome */
    .welcome-title {
      font-size: 15px;
      font-weight: bold;
      color: #1a2b4a;
      margin-bottom: 8px;
    }

    /* student info table */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .info-table td {
      border: 1px solid #dddddd;
      padding: 10px 18px;
    }

    .info-table td.label {
      width: 200px;
      font-weight: bold;
      color: #1a2b4a;
      background: #fafafa;
      letter-spacing: 0.5px;
    }

    .info-table td.value {
      color: #444444;
    }

    /* three columns */
    .three-cols {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .col-box {
      border: 1px solid #dddddd;
      background: #ffffff;
      display: flex;
      flex-direction: column;
    }

    .col-box .col-title {
      padding: 12px 18px;
      border-bottom: 1px solid #dddddd;
      font-size: 14px;
      font-weight: bold;
      color: #1a2b4a;
      background: #fafafa;
    }

    .col-box .col-content {
      padding: 18px;
      font-size: 13px;
      color: #555555;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .col-box .col-content p {
      margin-bottom: 10px;
      line-height: 1.5;
    }

    .status-text {
      font-size: 18px;
      font-weight: bold;
      color: #2e7d32;
      margin-bottom: 12px;
    }

    .btn {
      display: inline-block;
      padding: 8px 18px;
      background: #1a2b4a;
      color: #ffffff;
      font-size: 12px;
      font-weight: bold;
      border: none;
      cursor: pointer;
      align-self: flex-start;
      letter-spacing: 0.5px;
    }

    /* enrolled subjects */
    .subjects-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .subjects-table th {
      text-align: left;
      padding: 10px 18px;
      border-bottom: 1px solid #dddddd;
      font-size: 11px;
      letter-spacing: 1px;
      color: #1a2b4a;
      background: #fafafa;
      font-weight: bold;
    }

    .subjects-table td {
      padding: 10px 18px;
      border-bottom: 1px solid #eeeeee;
      color: #444444;
    }

    .subjects-table tr:last-child td {
      border-bottom: none;
    }

    .panel-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px;
      border-bottom: 1px solid #dddddd;
      background: #fafafa;
    }

    .panel-header-row .left {
      font-size: 14px;
      font-weight: bold;
      color: #1a2b4a;
    }

    .panel-header-row .right {
      font-size: 12px;
      color: #666666;
    }

    /* responsive */
    @media (max-width: 900px) {
      .three-cols {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .layout {
        flex-direction: column;
      }
      .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid #dddddd;
      }
      .info-table td.label {
        width: 120px;
      }
    }
  </style>
</head>
<body>

<div class="layout">
  <!-- ===== SIDEBAR ===== -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <h1>Enrollment</h1>
      <p>STUDENT PORTAL</p>
    </div>

    <div class="menu-label">MENU</div>
    <div class="menu-item active">
      <span class="icon">&#9632;</span> Dashboard
    </div>

    <div class="menu-label">ENROLLMENT</div>
    <div class="menu-item">
      <span class="icon">&#9654;</span> Enrollment
    </div>
    <div class="menu-item">
      <span class="icon">&#9993;</span> Enrollment Status
    </div>
    <div class="menu-item">
      <span class="icon">&#128196;</span> Certificate of Registration
    </div>

    <div class="menu-label">ACCOUNT</div>
    <div class="menu-item">
      <span class="icon">&#128100;</span> My Profile
    </div>
    <div class="menu-item">
      <span class="icon">&#128274;</span> Change Password
    </div>

    <div class="menu-label">&nbsp;</div>
    <div class="menu-item">
      <span class="icon">&#10162;</span> Logout
    </div>
  </aside>

  <!-- ===== MAIN ===== -->
  <div class="main">
    <!-- TOPBAR -->
    <div class="topbar">
      <h2>DASHBOARD</h2>
      <div class="user-info">
        <span></span>
        <div class="user-avatar">K</div>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <!-- Welcome -->
      <div class="panel">
        <div class="panel-body">
          <div class="welcome-title">Enrollment System!</div>
          <div>Here is your current student information.</div>
        </div>
      </div>

      <!-- Student Information -->
      <div class="panel">
        <div class="panel-title">Student Information</div>
        <table class="info-table">
          <tr>
            <td class="label">STUDENT NUMBER</td>
            <td class="value"></td>
          </tr>
          <tr>
            <td class="label">NAME</td>
            <td class="value"></td>
          </tr>
          <tr>
            <td class="label">COURSE</td>
            <td class="value"></td>
          </tr>
          <tr>
            <td class="label">YEAR LEVEL</td>
            <td class="value"></td>
          </tr>
        </table>
      </div>

      <!-- Three columns -->
      <div class="three-cols">
        <!-- My Profile -->
        <div class="col-box">
          <div class="col-title">My Profile</div>
          <div class="col-content">
            <p>View or update your personal information.</p>
            <button class="btn">View Profile</button>
          </div>
        </div>

        <!-- Enrollment -->
        <div class="col-box">
          <div class="col-title">Enrollment</div>
          <div class="col-content">
            <p>School Year: <strong>2026-2027</strong></p>
            <p>Semester: <strong>1st Semester</strong></p>
            <button class="btn">View Enrollment</button>
          </div>
        </div>

        <!-- Enrollment Status -->
        <div class="col-box">
          <div class="col-title">Enrollment Status</div>
          <div class="col-content">
            <div class="status-text">APPROVED</div>
            <p>Section: BSCS 1</p>
          </div>
        </div>
      </div>

      <!-- Enrolled Subjects -->
      <div class="panel">
        <div class="panel-header-row">
          <span class="left">Enrolled Subjects</span>
          <span class="right">7 subjects · 21 units</span>
        </div>
        <table class="subjects-table">
          <thead>
            <tr>
              <th>CODE</th>
              <th>SUBJECT</th>
              <th>UNITS</th>
              <th>YEAR LEVEL</th>
              <th>SEMESTER</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>CS301</td>
              <td>Software Engineering</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>CS302</td>
              <td>Web Development</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>CS303</td>
              <td>Database Management</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>CS304</td>
              <td>Data Structures</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>GE301</td>
              <td>Mathematics in the Modern World</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>GE302</td>
              <td>Purposive Communication</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
            <tr>
              <td>PE301</td>
              <td>Physical Education 3</td>
              <td>3</td>
              <td>3rd Year</td>
              <td>1st Semester</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div><!-- /content -->
  </div><!-- /main -->
</div><!-- /layout -->

</body>
</html>
